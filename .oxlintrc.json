{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "import"
  ],
  "categories": {},
  "env": {
    "builtin": true
  },
  "settings": {
    "react": {
      "version": "19.2.8"
    },
    "tailwindcss": {
      "callees": [
        "clsx",
        "cva",
        "cn"
      ]
    }
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "docs/"
  ]
}
